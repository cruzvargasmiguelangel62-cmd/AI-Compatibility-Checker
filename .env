# AI Local Hardware Detector - Configuration File

# UI Theme Settings
# Options: dark, light, system
APP_THEME=dark
# Options: blue, green, dark-blue
APP_COLOR_THEME=blue

# ==========================================
# COMPATIBILITY EVALUATION THRESHOLDS (in GB)
# ==========================================

# Apple Silicon Unified Memory Thresholds
# Buffer of free RAM required to run "Great" (default: 4.0 GB)
MAC_RAM_BUFFER_GREAT=4.0
# Buffer of free RAM required to run "Well" (default: 2.0 GB)
MAC_RAM_BUFFER_WELL=2.0

# Windows / Linux Dedicated GPU Thresholds
# Buffer of free VRAM required to run "Great" (default: 1.0 GB)
WIN_VRAM_BUFFER_GREAT=1.0
# Percentage of VRAM required to offload well (default: 0.7 i.e. 70%)
WIN_VRAM_MULTIPLIER_WELL=0.7
# Buffer of system RAM required when sharing load with GPU (default: 4.0 GB)
WIN_RAM_BUFFER_GPU_WELL=4.0

# CPU-Only / Fallback Memory Thresholds
# Buffer of system RAM required to run "Decent" on CPU (default: 6.0 GB)
CPU_RAM_BUFFER_DECENT=6.0
# Buffer of system RAM required to run "Tight Fit" on CPU (default: 2.0 GB)
CPU_RAM_BUFFER_TIGHT=2.0

# OS-Specific RAM Adjustments (in GB)
# Penalty for Windows due to heavier background footprint (default: 1.5 GB)
OS_RAM_PENALTY_WINDOWS=1.5
# Credit for Linux due to lighter footprint (default: -1.5 GB)
OS_RAM_PENALTY_LINUX=-1.5

# Online database URL of models (useful for loading the latest models)
ONLINE_MODELS_URL=https://raw.githubusercontent.com/cruzvargasmiguelangel62-cmd/AI-Compatibility-Checker/main/models_online.json
